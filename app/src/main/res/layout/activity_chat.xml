<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB"
    android:orientation="vertical">

    <!-- Top Bar with profile info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#8B0000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivChatPhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_profile_circle"
            android:contentDescription="Contact photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lavanya"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tap here for contact info"
                android:textColor="#FFCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnVideoCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video call"
            android:src="@drawable/ic_add_circle"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnVoiceCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice call"
            android:src="@drawable/ic_support"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Messages area -->
    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F0EB"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sent message (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:maxWidth="260dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_red_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="Good bye!"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        android:text="17:47"
                        android:textColor="#BDBDBD"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Date separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_box"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Fri, Jul 26"
                android:textColor="#555555"
                android:textSize="12sp" />

            <!-- Sent messages -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="6dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_red_pill"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="Good morning!"
                        android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="end" android:layout_marginTop="2dp"
                        android:text="10:10" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_red_pill"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="Japan looks amazing!"
                        android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="end" android:layout_marginTop="2dp"
                        android:text="10:10" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Received message (left) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_white_top_rounded"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="Do you know what time is it?"
                        android:textColor="#333333" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="11:40" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_red_pill"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="It's morning in Tokyo"
                        android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="end" android:layout_marginTop="2dp"
                        android:text="11:43" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Received -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_white_top_rounded"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="What is the most popular meal in Japan?"
                        android:textColor="#333333" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="11:45" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Received -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_white_top_rounded"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:text="Do you like it?"
                        android:textColor="#333333" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="11:45" android:textColor="#BDBDBD" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Attach"
            android:src="@drawable/ic_add_circle"
            app:tint="#8B0000" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_box"
            android:hint="Type a message..."
            android:textColor="#333333"
            android:textColorHint="#BDBDBD"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <ImageButton
            android:id="@+id/btnEmoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Emoji"
            android:src="@drawable/ic_notifications"
            app:tint="#9E9E9E" />

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Camera"
            android:src="@drawable/ic_upload"
            app:tint="#9E9E9E" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mic"
            android:src="@drawable/ic_support"
            app:tint="#9E9E9E" />
    </LinearLayout>

</LinearLayout>
